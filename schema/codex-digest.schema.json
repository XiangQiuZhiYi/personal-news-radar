{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": { "type": "string" },
          "contentSection": {
            "type": "string",
            "enum": ["关注城市", "职业/收入/技术", "国家级", "实用提醒", "国际", "热点"],
            "description": "互斥的每日内容板块，每条信息只能归入一个板块"
          },
          "category": {
            "type": "string",
            "enum": ["人工智能", "科技", "商业", "经济", "政策", "科学", "国际", "社会", "其他"]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "importance": {
            "type": "string",
            "enum": ["必读", "值得读", "可选"]
          },
          "summary": { "type": "string" },
          "whyItMatters": { "type": "string" },
          "impactForPeople": {
            "type": "string",
            "description": "面向普通个人或家庭的影响总览，概括最重要的实际变化"
          },
          "impactAnalysis": {
            "type": "object",
            "properties": {
              "impactLevel": {
                "type": "string",
                "enum": ["直接", "间接", "当前有限"]
              },
              "direction": {
                "type": "string",
                "enum": ["有利", "不利", "分化", "当前不变"]
              },
              "changeStatement": {
                "type": "string",
                "description": "直接说明谁的什么指标上升、下降、增加、减少、收紧、放宽、变快或变慢"
              },
              "affectedGroups": {
                "type": "array",
                "items": { "type": "string" }
              },
              "impactPath": { "type": "string" },
              "shortTerm": { "type": "string" },
              "mediumLongTerm": { "type": "string" },
              "actions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "uncertainties": { "type": "string" }
            },
            "required": [
              "impactLevel",
              "direction",
              "changeStatement",
              "affectedGroups",
              "impactPath",
              "shortTerm",
              "mediumLongTerm",
              "actions",
              "uncertainties"
            ],
            "additionalProperties": false
          },
          "confidence": {
            "type": "string",
            "enum": ["高", "中", "低"]
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "candidateId",
          "contentSection",
          "category",
          "score",
          "importance",
          "summary",
          "whyItMatters",
          "impactForPeople",
          "impactAnalysis",
          "confidence",
          "topics"
        ],
        "additionalProperties": false
      }
    },
    "discardedReasons": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["brief", "items", "discardedReasons"],
  "additionalProperties": false
}

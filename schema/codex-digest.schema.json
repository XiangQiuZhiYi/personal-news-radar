{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["人工智能", "科技", "商业", "经济", "政策", "科学", "国际", "社会", "其他"]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "importance": {
            "type": "string",
            "enum": ["必读", "值得读", "可选"]
          },
          "summary": { "type": "string" },
          "whyItMatters": { "type": "string" },
          "impactForPeople": {
            "type": "string",
            "description": "面向普通个人或家庭的影响总览，概括最重要的实际变化"
          },
          "impactAnalysis": {
            "type": "object",
            "properties": {
              "impactLevel": {
                "type": "string",
                "enum": ["直接", "间接", "当前有限"]
              },
              "affectedGroups": {
                "type": "array",
                "items": { "type": "string" }
              },
              "impactPath": { "type": "string" },
              "shortTerm": { "type": "string" },
              "mediumLongTerm": { "type": "string" },
              "actions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "uncertainties": { "type": "string" }
            },
            "required": [
              "impactLevel",
              "affectedGroups",
              "impactPath",
              "shortTerm",
              "mediumLongTerm",
              "actions",
              "uncertainties"
            ],
            "additionalProperties": false
          },
          "confidence": {
            "type": "string",
            "enum": ["高", "中", "低"]
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "candidateId",
          "category",
          "score",
          "importance",
          "summary",
          "whyItMatters",
          "impactForPeople",
          "impactAnalysis",
          "confidence",
          "topics"
        ],
        "additionalProperties": false
      }
    },
    "discardedReasons": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["brief", "items", "discardedReasons"],
  "additionalProperties": false
}
